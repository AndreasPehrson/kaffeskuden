# Instagram Graph API - run: npm run fetch-instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Optional: max posts to download (default 12)
# INSTAGRAM_FETCH_LIMIT=12

# Contact form API (Cloudflare Worker). Local dev uses Vite proxy to wrangler.
# VITE_CONTACT_API_URL=/api/contact

# Google Analytics 4 (production only). Create at https://analytics.google.com/
# QR scans use https://kaffeskuden.dk/?utm_source=qr — visible under Acquisition in GA4.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
